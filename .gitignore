# Python cache
__pycache__/
*.py[cod]

# Notebook checkpoints
.ipynb_checkpoints/

# Secrets
.env
.env.*
.gemini_key

# Virtual environments
venv/
.venv/

# macOS
.DS_Store

# Editor settings
.vscode/

# Logs
*.log

# Ignore raw datasets — download from Kaggle directly
drugsComTrain_raw.csv
drugsComTest_raw.csv

# Ignore large generated files — produced by pipeline at runtime
cleaned_drug_reviews.csv

# Ignore intermediate pipeline data folders
data/raw/
data/processed/

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/final/.gitkeep

# Ignore auto-generated patched notebooks — created by pipeline at runtime
*_fixed.ipynb

# Ignore parquet files
*.parquet

# Temporary files
tmp/
temp/
